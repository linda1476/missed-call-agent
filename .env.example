# Copy to .env and fill in. Never commit .env.

# AssemblyAI API key (event credits activated via lablab signup link)
ASSEMBLYAI_API_KEY=

# Base URL of this service when hosted (used for HTTP tool callbacks + P0-8 test)
PUBLIC_URL=http://localhost:8000

# Local SQLite store location
STORE_PATH=./data/store.db

# Bearer key protecting /tools/* and /dashboard/* (required for deployment;
# unset = dev mode, everything open). Configure the same value as an
# Authorization header on the HTTP tools in the AssemblyAI session.
TOOLS_API_KEY=

# Optional: spend cap in USD; the app refuses new call sessions once the
# day's accumulated session seconds exceed this at $4.50/hr
DAILY_SPEND_CAP_USD=20
