# Copy to .env and fill in. Never commit .env.

# AssemblyAI API key (event credits activated via lablab signup link)
ASSEMBLYAI_API_KEY=

# Base URL of this service when hosted (used for HTTP tool callbacks + P0-8 test)
PUBLIC_URL=http://localhost:8000

# Local SQLite store location
STORE_PATH=./data/store.db

# Optional: spend cap in USD; the app refuses Voice Agent sessions above this daily estimate
DAILY_SPEND_CAP_USD=20
