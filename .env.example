# Copy to .env and fill in. Never commit .env.

# AssemblyAI API key (event credits activated via lablab signup link)
ASSEMBLYAI_API_KEY=

# Base URL of this service when hosted (used for HTTP tool callbacks + P0-8 test)
PUBLIC_URL=http://localhost:8000

# Local SQLite store location
STORE_PATH=./data/store.db

# Bearer key protecting /tools/* and /dashboard/* (required for deployment;
# unset = dev mode, everything open). Configure the same value as an
# Authorization header on the HTTP tools in the AssemblyAI session.
TOOLS_API_KEY=

# Optional: spend cap in USD; the app refuses new call sessions once the
# day's accumulated session seconds exceed this at $4.50/hr
DAILY_SPEND_CAP_USD=20

# Comma-separated slot ids for the shop's bookable inventory. Without these
# the slot table is empty and every booking fails. Required for deployment.
SEED_SLOTS=fri-1800,fri-1900,fri-2000,sat-1200,sat-1900,sat-2000

# IANA timezone of the shop (e.g. America/New_York). "Tomorrow"/"tonight"
# resolve against the shop's local date — set this when the host runs in a
# different timezone than the shop. Unset = server local date.
SHOP_TZ=

# Max simultaneous active bookings one caller may hold (inventory-exhaustion
# guard for the public /call surface). 0 = unlimited. A move (swap) is not
# blocked by this cap.
SLOT_PER_CALLER_CAP=4
